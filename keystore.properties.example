# Copy to keystore.properties (gitignored) after creating your release keystore.
# Do NOT commit keystore.properties or *.jks files.
#
# Generate keystore (run once, store backup safely):
#   keytool -genkey -v -keystore release-keystore.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias marine-weather
#
storeFile=release-keystore.jks
storePassword=REPLACE_ME
keyAlias=marine-weather
keyPassword=REPLACE_ME
